# =============================================================================
# emergencIA — variáveis de ambiente
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel:
# Project → Settings → Environment Variables. NUNCA faça commit de valores reais.
# Todas são opcionais em desenvolvimento: sem elas o app roda com armazenamento
# em memória e o simulador web (sem WhatsApp).
# =============================================================================

# --- WhatsApp Cloud API (Meta for Developers → seu app → WhatsApp → API Setup) ---
# Token de acesso (temporário de 24 h para testes ou permanente de "System User").
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" do número remetente (NÃO é o número de telefone).
WHATSAPP_PHONE_NUMBER_ID=
# Texto livre escolhido por você; o mesmo valor vai no campo "Verify token" do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=troque-este-token
# App Secret (App settings → Basic). Usado para validar a assinatura X-Hub-Signature-256.
WHATSAPP_APP_SECRET=
# Versão da Graph API.
WHATSAPP_API_VERSION=v23.0
# Número público do bot (só dígitos, com DDI), usado no botão "Falar no WhatsApp" da página inicial.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Persistência (Upstash Redis via Vercel Marketplace; preenchidas automaticamente) ---
# Aceita qualquer um dos pares abaixo. Sem eles, o armazenamento é em memória (perde dados).
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Painel do hospital ---
# Token exigido pelo painel /hospital e pelas APIs /api/alerts. Vazio = aberto (só para dev!).
DASHBOARD_TOKEN=

# --- Notificação do hospital (opcionais) ---
# Número de WhatsApp (só dígitos, com DDI) que recebe TODOS os chamados (ex.: celular de quem
# faz o papel do hospital na demonstração). Precisa estar na lista de destinatários de teste.
HOSPITAL_NOTIFY_WHATSAPP=
# URL que recebe um POST JSON com cada chamado (integração com sistemas do hospital).
HOSPITAL_WEBHOOK_URL=

# --- Simulador web ---
# "false" desativa /simulador e /api/simulator em produção.
ENABLE_SIMULATOR=true
